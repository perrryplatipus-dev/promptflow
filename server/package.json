{
  "name": "promptflow-server",
  "version": "1.0.0",
  "description": "Backend streaming server for PromptFlow A/B tester",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --watch index.ts --exec ts-node index.ts",
    "build": "tsc",
    "start": "ts-node index.ts",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.15.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "nodemailer": "^9.0.3",
    "openai": "^4.52.7",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^8.0.1",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}
