# PromptFlow Server Environment Configurations

PORT=3001

# ==============================================================================
# SMTP TRANSACTIONAL MAIL SETUP FOR REAL OTP INBOX DELIVERY
# ==============================================================================
# To receive OTP authorization codes in your real Mail application (e.g., Gmail, Outlook, Apple Mail),
# fill in your details below.
#
# FOR GMAIL:
# 1. Go to your Google Account Settings -> Security.
# 2. Enable 2-Step Verification.
# 3. Search for "App Passwords" and create a new App Password (e.g., named "PromptFlow").
# 4. Use the generated 16-character password below (without spaces).
# ==============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=PromptFlow <noreply@promptflow.ai>
DATABASE_URL="postgresql://postgres:password@localhost:5432/promptflow"
